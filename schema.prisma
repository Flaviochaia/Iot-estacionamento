generator client {
  provider  = "prisma-client-py"
  interface = "asyncio"
}

datasource db {
  provider = "sqlite"
  url      = "file:./parking.db"
}

model Spot {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  occupied  Boolean   @default(false)
  updatedAt DateTime  @updatedAt
  readings  Reading[]
  events    Event[]
}

model Reading {
  id         Int      @id @default(autoincrement())
  spot       Spot     @relation(fields: [spotId], references: [id])
  spotId     Int
  distanceCm Float
  valid      Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model Event {
  id        Int      @id @default(autoincrement())
  spot      Spot?    @relation(fields: [spotId], references: [id])
  spotId    Int?
  type      String   // ENTRY, EXIT, FULL_ALERT
  createdAt DateTime @default(now())
}